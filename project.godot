[application]

config/name="Torpedos"
config/description="A simple asteroids-inspired game where you dodge the torpedos!"
config/version="1.1.0"
run/main_scene="uid://bufi3p2gk03ca"
config/features=PackedStringArray("4.7", "Mobile")
boot_splash/bg_color=Color(0, 0, 0, 1)
boot_splash/image="uid://bbn0q5v3fwo86"
